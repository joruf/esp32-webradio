<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<!--
  Minimal AI-Thinker ESP32-CAM Fritzing part for ESP32-Webradio (cam_headless).
  Camera module removed; camera-interface GPIOs are exposed for VS1053 / encoder.
  SD_MMC 1-bit (GPIO2/14/15) is onboard; no external SD CS jumper.
-->
<module fritzingVersion="0.9.6" moduleId="ESP32-CAM-AIThinker">
  <version>1</version>
  <author>ESP32-Webradio</author>
  <title>ESP32-CAM AI-Thinker (no camera)</title>
  <label>U</label>
  <date>2026-03-26</date>
  <tags>
    <tag>ESP32</tag>
    <tag>ESP32-CAM</tag>
    <tag>AI-Thinker</tag>
    <tag>wifi</tag>
    <tag>module</tag>
  </tags>
  <properties>
    <property name="family">ESP32</property>
    <property name="variant">CAM AI-Thinker headless</property>
    <property name="part number">ESP32-CAM-AIThinker</property>
    <property name="type">ESP32-CAM</property>
    <property name="pins">15</property>
  </properties>
  <description>
    Minimal ESP32-CAM (AI-Thinker) wiring part for headless Webradio use.
    Includes 3V3, GND and GPIOs used by VS1053, SPI and rotary encoder.
    SD_MMC pins GPIO2 (D0), GPIO14 (CLK), GPIO15 (CMD) are labeled as onboard only.
    Some GPIOs are camera FPC pads when the camera is fitted; use without camera.
  </description>
  <views>
    <iconView>
      <layers image="icon/ESP32-CAM-AIThinker_icon.svg">
        <layer layerId="icon"/>
      </layers>
    </iconView>
    <schematicView>
      <layers image="schematic/ESP32-CAM-AIThinker_schematic.svg">
        <layer layerId="schematic"/>
      </layers>
    </schematicView>
    <breadboardView>
      <layers image="breadboard/ESP32-CAM-AIThinker_breadboard.svg">
        <layer layerId="breadboard"/>
      </layers>
    </breadboardView>
    <pcbView>
      <layers image="breadboard/ESP32-CAM-AIThinker_breadboard.svg">
        <layer layerId="copper0"/>
      </layers>
    </pcbView>
  </views>
  <connectors>
    <connector id="connector0" type="male" name="3V3">
      <description>+3.3 Volts</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" type="male" name="GND">
      <description>Ground</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector2" type="male" name="GPIO4">
      <description>VS1053 DREQ (also flash LED)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector2pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector3" type="male" name="GPIO5">
      <description>VS1053 CS (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector3pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector4" type="male" name="GPIO18">
      <description>SPI SCK (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector4pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector5" type="male" name="GPIO19">
      <description>SPI MISO (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector5pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector5pin" terminalId="connector5terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector5pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector6" type="male" name="GPIO23">
      <description>SPI MOSI (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector6pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector6pin" terminalId="connector6terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector6pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector7" type="male" name="GPIO25">
      <description>Encoder CLK (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector7pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector7pin" terminalId="connector7terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector7pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector8" type="male" name="GPIO26">
      <description>Encoder DT (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector8pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector8pin" terminalId="connector8terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector8pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector9" type="male" name="GPIO27">
      <description>Encoder SW (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector9pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector9pin" terminalId="connector9terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector9pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector10" type="male" name="GPIO32">
      <description>VS1053 DCS (camera pad when camera fitted)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector10pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector10pin" terminalId="connector10terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector10pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector11" type="male" name="GPIO2">
      <description>SD_MMC D0 (onboard, no external jumper)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector11pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector11pin" terminalId="connector11terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector11pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector12" type="male" name="GPIO14">
      <description>SD_MMC CLK (onboard, no external jumper)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector12pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector12pin" terminalId="connector12terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector12pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector13" type="male" name="GPIO15">
      <description>SD_MMC CMD (onboard, no external jumper)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector13pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector13pin" terminalId="connector13terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector13pin"/></pcbView>
      </views>
    </connector>
    <connector id="connector14" type="male" name="5V">
      <description>+5 Volts (optional board supply)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector14pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector14pin" terminalId="connector14terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector14pin"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
