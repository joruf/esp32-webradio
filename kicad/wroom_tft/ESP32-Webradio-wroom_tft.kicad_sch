  (text "ESP32-Webradio wroom_tft – Verdrahtungsmodell\nQuelle: wiring/pin_connections.txt + hardware_profile.h\nGemeinsamer SPI: SCK=18 MOSI=23 MISO=19\nTFT RST und VS1053 RST fest an +3V3 (Firmware: tft rst=-1)\nTFT MISO optional (viele 8-Pin-Module ohne MISO)\nGPIO35 = IR optional"
    (exclude_from_sim no)
    (at 10.00 10.00 0)
    (effects (font (size 1.50 1.50)) (justify left top))
    (uuid "1e0df1bd-e70c-43fb-944c-890607a90db1")
  )
  (text "Netzliste (Kurz)\n+3V3: ESP, VS1053 3V3+RST, TFT VCC+RST, Encoder +\nGND: ESP, VS1053, TFT, Encoder\nSPI_SCK/MOSI/MISO: ESP↔VS1053↔TFT\nVS: CS=5 DCS=32 DREQ=4 SDCS=21\nTFT: CS=15 DC=2 BL=33\nENC: CLK=25 DT=26 SW=27"
    (exclude_from_sim no)
    (at 10.00 200.00 0)
    (effects (font (size 1.50 1.50)) (justify left top))
    (uuid "37704612-5f8d-4cfc-8a7a-4d0f998667aa")
  )
